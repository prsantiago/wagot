# Copy to .env and fill in:   cp .env.example .env
# Variables set in the real environment override this file.

# Port the HTTP server listens on.
PORT=

# Graph API version used for Cloud API calls.
WHATSAPP_API_VERSION=

# Business phone number ID (not the phone number itself).
# Meta App Dashboard > WhatsApp > API Setup > "Phone number ID".
WHATSAPP_PHONE_NUMBER_ID=

# Access token used to send messages. The temporary token on the API Setup
# page expires after 24h; for anything longer, create a System User token with
# the whatsapp_business_messaging permission in Business Settings.
WHATSAPP_ACCESS_TOKEN=

# Any secret string you choose. Enter the same value as "Verify token" in
# Meta App Dashboard > WhatsApp > Configuration > Webhook.
WHATSAPP_VERIFY_TOKEN=

# App secret used to check that webhooks really come from Meta.
# Meta App Dashboard > App settings > Basic > "App secret".
WHATSAPP_APP_SECRET=
